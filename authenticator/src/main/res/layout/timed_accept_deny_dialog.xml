<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tool="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/md_theme_dark_background"
    tool:context="ui.TimedAcceptDenyDialog">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:paddingBottom="16dp">

        <FrameLayout
            android:id="@+id/iconContainer"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="8dp"
            android:background="@drawable/m3_icon_badge_primary">

            <ImageView
                android:id="@+id/iconView"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:adjustViewBounds="true"
                android:contentDescription="@string/generic_icon"
                android:scaleType="centerInside"
                android:tint="@color/md_theme_dark_onPrimary"
                android:src="@drawable/ic_key"
                tool:visibility="visible" />
        </FrameLayout>

        <TextView
            android:id="@+id/titleView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:gravity="center"
            android:paddingHorizontal="@dimen/text_horizontal_padding"
            android:text="@null"
            android:textAppearance="@style/TextAppearance.WearAuthn.Title"
            android:visibility="gone"
            tool:text="WearAuthn"
            tool:visibility="visible" />

        <TextView
            android:id="@+id/messageView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:hyphenationFrequency="full"
            android:paddingHorizontal="@dimen/text_horizontal_padding"
            android:text="@null"
            android:textAppearance="@style/TextAppearance.WearAuthn.Body"
            android:visibility="gone"
            tool:text="Authenticate to Google?"
            tool:visibility="visible" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/buttonPanel"
                style="?android:attr/buttonBarStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:gravity="center_horizontal|center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/diag_button_padding_horizontal"
                android:paddingTop="4dp"
                android:paddingEnd="@dimen/diag_button_padding_horizontal"
                android:paddingBottom="8dp"
                android:visibility="gone"
                tool:visibility="visible">

                <androidx.wear.widget.CircularProgressLayout
                    android:id="@+id/negativeTimeout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="2dp"
                    android:visibility="gone"
                    app:backgroundColor="@color/md_theme_dark_surfaceContainerHigh"
                    app:colorSchemeColors="@color/md_theme_dark_primary"
                    app:strokeWidth="3dp"
                    tool:visibility="visible">

                    <ImageButton
                        android:id="@+id/negativeButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/m3_button_deny_circle"
                        android:contentDescription="@string/generic_deny"
                        android:tint="@color/md_theme_dark_onSurface"
                        android:src="@drawable/ic_close" />
                </androidx.wear.widget.CircularProgressLayout>

                <Space
                    android:id="@+id/spacer"
                    android:layout_width="16dp"
                    android:layout_height="0dp"
                    android:visibility="gone"
                    tool:visibility="visible" />

                <ImageButton
                    android:id="@+id/positiveButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/m3_button_accept_circle"
                    android:contentDescription="@string/generic_accept"
                    android:tint="@color/md_theme_dark_onPrimary"
                    android:src="@drawable/ic_check"
                    android:visibility="gone"
                    tool:visibility="visible" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</ScrollView>
