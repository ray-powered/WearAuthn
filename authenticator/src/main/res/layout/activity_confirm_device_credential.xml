<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/md_theme_dark_background"
    tools:context=".ui.ConfirmDeviceCredentialActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="24dp">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/m3_icon_badge_primary">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@string/confirm_device_credential_title"
                android:src="@drawable/ic_lock"
                android:tint="@color/md_theme_dark_onPrimary" />
        </FrameLayout>

        <TextView
            android:id="@+id/titleView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:gravity="center"
            android:text="@string/confirm_device_credential_title"
            android:textAppearance="@style/TextAppearance.WearAuthn.Title" />

        <TextView
            android:id="@+id/messageView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:text="@string/confirm_device_credential_message"
            android:textAppearance="@style/TextAppearance.WearAuthn.Body" />

        <Button
            android:id="@+id/continueButton"
            style="@style/Widget.WearAuthn.Button.PillPrimary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/generic_continue" />

        <Button
            android:id="@+id/cancelButton"
            style="@style/Widget.WearAuthn.Button.PillSurface"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/generic_cancel" />

    </LinearLayout>
</ScrollView>
